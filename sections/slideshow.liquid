<section>
   <p>Slideshow</p>
</section>

{% schema %}
{
  "name": "Slideshow",
  "disabled_on": {
    "groups": ["footer", "header"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3,
      "max": 15,
      "unit": "sec",
      "default": 6
    },
    {
      "type": "range",
      "id": "slideshow_height",
      "label": "Slideshow height",
      "min": 30,
      "max": 100,
      "unit": "%",
      "default": 100
    }
  ],
  "blocks": [
    {
      "name": "Image",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "default": "/"
        },
        {
          "type": "select",
          "id": "text_alignment_desktop",
          "label": "Text alignment (desktop)",
          "options": [
            {
              "label": "Left",
              "value": "left"
            },
            {
              "label": "Center",
              "value": "center"
            },
            {
              "label": "Right",
              "value": "right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_alignment_mobile",
          "label": "Text alignment (mobile)",
          "options": [
            {
              "label": "Left",
              "value": "left"
            },
            {
              "label": "Center",
              "value": "center"
            },
            {
              "label": "Right",
              "value": "right"
            }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_label_color",
          "label": "Button label",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_background_color",
          "label": "Button background",
          "alpha": true,
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "overlay",
          "label": "Overlay",
          "alpha": true,
          "default": "#cecece33"
        }
      ]
    },
    {
      "name": "HTML video",
      "type": "html_video",
      "settings": [
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Video (desktop)"
